lacultureta.com {
    encode zstd gzip
    reverse_proxy 127.0.0.1:3100
    header Strict-Transport-Security "max-age=31536000"
    log {
        output file /var/log/caddy/lacultureta.log {
            roll_size 10MiB
            roll_keep 3
        }
    }
}
www.lacultureta.com {
    redir https://lacultureta.com{uri} permanent
}
